{{!< default}}

<section class="publication-masthead">
    <div class="publication-masthead__inner">
        <p class="eyebrow">Essays</p>
        <h1>{{@site.title}}</h1>
        {{#if @site.description}}
            <p class="publication-masthead__deck">{{@site.description}}</p>
        {{/if}}
    </div>
    <div class="publication-masthead__mark" aria-hidden="true">{{date format="WW"}}</div>
</section>

{{#if posts}}
    <section class="post-feed-wrap" aria-label="Latest writing">
        <div class="post-feed">
            {{#foreach posts}}
                {{> "card" feature=@first}}
            {{/foreach}}
        </div>
        {{pagination}}
    </section>

    {{#if @site.members_enabled}}
        {{#unless @member}}
            <section class="signup-panel signup-panel--page">
                <p class="eyebrow">Newsletter</p>
                <h2>{{@site.title}}</h2>
                {{#if @site.description}}
                    <p>{{@site.description}}</p>
                {{/if}}
                <a class="button button--paper" href="{{@site.signup_url}}">Subscribe</a>
            </section>
        {{/unless}}
    {{/if}}
{{else}}
    <section class="empty-state">
        {{#if @site.description}}<h2>{{@site.description}}</h2>{{/if}}
        {{#if @site.members_enabled}}
            <a class="button" href="{{@site.signup_url}}">Subscribe</a>
        {{/if}}
    </section>
{{/if}}
