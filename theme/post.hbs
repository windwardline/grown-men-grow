{{!< default}}

{{#post}}
<article class="article {{post_class}}">
    <header class="article-header">
        <div class="article-header__inner">
            <div class="article-header__kicker">
                {{#if primary_tag}}
                    <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                {{else}}
                    <span>Essay</span>
                {{/if}}
                <span>Issue {{date format="YYYY.WW"}}</span>
            </div>

            <h1>{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="article-header__deck">{{custom_excerpt}}</p>
            {{/if}}

            <div class="article-header__meta">
                <span class="article-header__brand">{{@site.title}}</span>
                <span class="article-header__byline">
                    By
                    {{#foreach authors}}
                        <a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}
                    {{/foreach}}
                </span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
                <span>{{reading_time}}</span>
            </div>
        </div>

        {{#if feature_image}}
            <figure class="article-header__figure">
                {{> "feature-image" eager=true sizes="(max-width: 760px) 100vw, 1440px"}}
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}
    </header>

    <div class="article-content gh-content">
        {{content}}
    </div>

    <footer class="article-footer">
        {{#if tags}}
            <div class="article-tags">
                <span class="eyebrow">Filed under</span>
                {{#foreach tags}}
                    <a href="{{url}}">{{name}}</a>
                {{/foreach}}
            </div>
        {{/if}}

        {{#if comments}}
            <section class="article-comments">
                {{comments}}
            </section>
        {{/if}}

        {{#if @site.members_enabled}}
            <section class="signup-panel">
                <p class="eyebrow">Newsletter</p>
                <h2>{{@site.title}}</h2>
                {{#if @site.description}}
                    <p>{{@site.description}}</p>
                {{/if}}
                <a class="button button--paper" href="{{@site.signup_url}}">Subscribe</a>
            </section>
        {{/if}}

        <div class="article-authors">
            {{#foreach authors}}
                <section class="author-card{{#unless profile_image}} author-card--no-image{{/unless}}">
                    {{#if profile_image}}
                        <a href="{{url}}" aria-label="More from {{name}}">
                            <img src="{{img_url profile_image size="xs"}}" alt="" width="96" height="96" loading="lazy">
                        </a>
                    {{/if}}
                    <div>
                        <p class="eyebrow">Contributor</p>
                        <h2><a href="{{url}}">{{name}}</a></h2>
                        {{#if bio}}<p>{{bio}}</p>{{/if}}
                    </div>
                </section>
            {{/foreach}}
        </div>
    </footer>
</article>
{{/post}}
