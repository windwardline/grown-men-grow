<article class="post-card {{post_class}}{{#if feature}} post-card--feature{{/if}}">
    {{#if feature_image}}
        <a class="post-card__media" href="{{url}}" aria-label="Read {{title}}">
            {{> "feature-image" eager=feature sizes="(max-width: 760px) 100vw, (max-width: 1200px) 58vw, 760px"}}
        </a>
    {{/if}}

    <div class="post-card__body">
        <div class="post-card__kicker">
            {{#if primary_tag}}
                <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
            {{else}}
                <span>Essay</span>
            {{/if}}
            <span aria-hidden="true">/</span>
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
        </div>

        <h2 class="post-card__title"><a href="{{url}}">{{title}}</a></h2>

        {{#if custom_excerpt}}
            <p class="post-card__excerpt">{{custom_excerpt}}</p>
        {{else if excerpt}}
            <p class="post-card__excerpt">{{excerpt words="28"}}</p>
        {{/if}}

        <div class="post-card__footer">
            <span>{{reading_time}}</span>
            <a class="text-link" href="{{url}}">Read <span aria-hidden="true">&rarr;</span></a>
        </div>
    </div>
</article>
