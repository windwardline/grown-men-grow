{{!< default}}

{{#author}}
<header class="collection-header collection-header--author">
    <div>
        <p class="eyebrow">Contributor</p>
        <h1>{{name}}</h1>
        {{#if bio}}<p class="collection-header__deck">{{bio}}</p>{{/if}}
        <div class="collection-header__meta">
            {{#if location}}<span>{{location}}</span>{{/if}}
            {{#if website}}<a href="{{website}}" rel="noopener">Website</a>{{/if}}
        </div>
    </div>
    {{#if profile_image}}
        <img class="collection-header__portrait" src="{{img_url profile_image size="m"}}" alt="{{name}}" width="480" height="600">
    {{/if}}
</header>
{{/author}}

<section class="collection-feed" aria-label="Writing by this contributor">
    {{#foreach posts}}
        {{> "card"}}
    {{/foreach}}
    {{pagination}}
</section>
